# Optional Docker Compose PostgreSQL container settings. Change the example password.
POSTGRES_DB=floor_plan_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-development-password

# PostgreSQL connection string for the local Node API.
DATABASE_URL=postgres://postgres:change-this-local-development-password@localhost:5432/floor_plan_studio
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10

# API server
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

# Sessions
SESSION_DAYS=30
SESSION_COOKIE_NAME=fps_session
COOKIE_SAME_SITE=lax

# Google Identity Services: use the same OAuth Web client ID in both variables.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
