# Copy this file to .env on the server. Never commit the populated .env.
# DNS A record (and optional AAAA record) must point to this server.
DOMAIN=planner.example.com
ACME_EMAIL=admin@example.com

# Use a URL-safe password (hex is recommended): openssl rand -hex 32
POSTGRES_DB=floor_plan_studio
POSTGRES_ADMIN_USER=fps_admin
POSTGRES_PASSWORD=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
APP_DB_USER=fps_app
APP_DB_PASSWORD=REPLACE_WITH_A_SECOND_OPENSSL_RAND_HEX_32

# Optional Google Identity Services Web Client ID. Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional operational settings
IMAGE_TAG=latest
PG_POOL_MAX=10
SESSION_DAYS=30
SESSION_COOKIE_NAME=fps_session
